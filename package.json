{
  "name": "exemplarium-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Exemplarium: a TypeScript-native design-system intelligence workbench for React, Next.js, Tailwind CSS, and Storybook migration.",
  "license": "MIT",
  "author": {
    "name": "Tim Baker",
    "email": "239700173+TimBakerCircle@users.noreply.github.com",
    "url": "https://github.com/TimBakerCircle"
  },
  "type": "module",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "packages/core",
    "packages/next",
    "packages/tailwind",
    "packages/agents",
    "packages/preview",
    "packages/codemods",
    "packages/storybook-compat",
    "packages/analyzer",
    "packages/cli",
    "packages/ui",
    "apps/exemplarium"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "dev": "npm run dev -w exemplarium",
    "index": "npm run exemplarium -- index",
    "exemplarium": "node packages/cli/dist/index.js",
    "clean": "git clean -fdX packages apps"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "typescript": "6.0.3",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
